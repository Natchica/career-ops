    "search_queries": [
      {
        "name": "Greenhouse — Rust Switzerland",
        "query": "site:job-boards.greenhouse.io \"Rust\" (\"Switzerland\" OR \"Zurich\" OR \"Zug\" OR \"Basel\")",
        "enabled": true
      },
      {
        "name": "Ashby — Rust Switzerland",
        "query": "site:jobs.ashbyhq.com \"Rust\" (\"Switzerland\" OR \"Zurich\" OR \"Zug\" OR \"Basel\")",
        "enabled": true
      },
      {
        "name": "Lever — Rust Switzerland",
        "query": "site:jobs.lever.co \"Rust\" (\"Switzerland\" OR \"Zurich\" OR \"Zug\" OR \"Basel\")",
        "enabled": true
      },
      {
        "name": "Workday — Rust Switzerland",
        "query": "site:myworkdayjobs.com \"Rust\" (\"Switzerland\" OR \"Zurich\" OR \"Basel\")",
        "enabled": true
      },
      {
        "name": "SmartRecruiters — Rust Switzerland",
        "query": "site:jobs.smartrecruiters.com \"Rust\" (\"Switzerland\" OR \"Zurich\" OR \"Basel\")",
        "enabled": true
      },
      {
        "name": "Rust backend — Basel trinational area",
        "query": "\"Rust\" (\"Softwareentwickler\" OR \"Software Engineer\" OR \"Backend\") (\"Basel\" OR \"Loerrach\" OR \"Weil am Rhein\" OR \"Mulhouse\")",
        "enabled": true
      },
      {
        "name": "Rust — Crypto Valley (Zug/Zurich)",
        "query": "\"Rust\" (\"blockchain\" OR \"protocol\" OR \"node\") (\"Zug\" OR \"Zurich\" OR \"Crypto Valley\") jobs",
        "enabled": true
      },
      {
        "name": "Rust — confidential computing / TEE",
        "query": "\"Rust\" (\"confidential computing\" OR \"Intel TDX\" OR \"SGX\" OR \"trusted execution\") jobs (\"Switzerland\" OR \"Europe\")",
        "enabled": true
      },
      {
        "name": "Rust — Alsace / Haut-Rhin",
        "query": "\"Rust\" (\"developpeur\" OR \"ingenieur\" OR \"developer\") (\"Mulhouse\" OR \"Colmar\" OR \"Strasbourg\" OR \"Haut-Rhin\")",
        "enabled": true
      },
      {
        "name": "Wellfound — Rust Europe remote",
        "query": "site:wellfound.com \"Rust\" (\"remote\" OR \"Europe\") engineer",
        "enabled": false
      }
    ],
